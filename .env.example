# Скопируйте этот файл в .env и заполните значения.
# .env уже добавлен в .gitignore — НИКОГДА не коммитьте его.

# --- AI Brain ---
# Ключ: https://console.anthropic.com/settings/keys  (без кавычек и пробелов)
ANTHROPIC_API_KEY=

# Модель Claude, используемая AI Brain.
JARVIS_AI_MODEL=claude-opus-5-5
# Глубина размышлений: low (быстрее, дешевле) | medium | high | xhigh | max
JARVIS_AI_EFFORT=low
# Максимальная длина ответа в токенах (включая размышления модели).
JARVIS_AI_MAX_TOKENS=16000
# Таймаут одного запроса к AI (сек) и число автоматических повторов при сбоях сети.
JARVIS_AI_TIMEOUT_SECONDS=60
JARVIS_AI_MAX_RETRIES=2
# Через сколько обменов репликами разговор сжимается в краткое резюме и начинается заново.
JARVIS_AI_MAX_TURNS=30
# Если фильтр безопасности модели ошибочно отклонит запрос — повторить на резервной модели.
JARVIS_AI_FALLBACKS=true

# --- Персонализация ---
# Как JARVIS обращается к вам.
JARVIS_USER_TITLE=Boss
# Язык ответов: ru | en
JARVIS_LANGUAGE=ru

# --- Хранилище и логи ---
# Папка для памяти, логов и audit log (относительно папки запуска или абсолютный путь).
JARVIS_DATA_DIR=data
# DEBUG | INFO | WARNING | ERROR
JARVIS_LOG_LEVEL=INFO
# Дублировать логи в консоль (иначе только в data/logs/jarvis.log).
JARVIS_LOG_TO_CONSOLE=false
